{
  "buildCommand": "cd web && npm ci && npm run build:vercel",
  "outputDirectory": "web/dist",
  "installCommand": "cd web && npm ci",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
