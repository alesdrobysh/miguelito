TRANSPORT=telegram    # telegram or tui
TELEGRAM_BOT_TOKEN=   # required when TRANSPORT=telegram
PROVIDER=openrouter   # openrouter (default) or ollama
OPENROUTER_API_KEY=   # required when PROVIDER=openrouter
OPENROUTER_MODEL=minimax/minimax-m2.5:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=       # optional, for authenticated Ollama proxies
DB_PATH=./data/buddy.db
ALLOWED_USERS=
MORNING_CRON=0 9 * * *
EVENING_CRON=30 19 * * *
TIMEZONE=Europe/Warsaw
TELEGRAM_CHAT_ID=      # required when TRANSPORT=telegram
