TRANSPORT=telegram    # telegram, tui, or web
TELEGRAM_BOT_TOKEN=   # required when TRANSPORT=telegram
PROVIDER=openrouter   # openrouter (default); use ollama only if an Ollama/OpenAI-compatible server is reachable
OPENROUTER_API_KEY=   # required when PROVIDER=openrouter
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
EVALUATOR_MODEL=google/gemini-2.0-flash-lite-001 # cheaper deterministic post-turn evaluator; defaults to OPENROUTER_MODEL if omitted
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=       # optional, for authenticated Ollama proxies
DB_PATH=./data/buddy.db
DATA_DIR=./data       # web mode stores per-language DBs and memory under this directory
WEB_HOST=127.0.0.1    # web mode only; use 0.0.0.0 to expose on LAN/tunnel
WEB_PORT=8787         # web mode only
ALLOWED_USERS=
MORNING_CRON=0 9 * * *
EVENING_CRON=30 19 * * *
TIMEZONE=Europe/Warsaw
TELEGRAM_CHAT_ID=      # required when TRANSPORT=telegram
