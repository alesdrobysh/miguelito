{
  "name": "miguelito-ts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cd src && find languages -name \"soul.md\" -o -path \"languages/frequency/*.txt\" | rsync -R --files-from=- . ../dist/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:consolidate": "tsx scripts/consolidate-db.ts",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "grammy": "^1.43.0",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
